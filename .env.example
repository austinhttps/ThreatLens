# ThreatLens Configuration Environment Variables
PORT=3000
NODE_ENV=development

# Cache Settings (Default 900 seconds = 15 minutes)
CACHE_TTL_SECONDS=900

# API Keys (Optional - System will use realistic mock data in Demo Mode if not provided)
# Obtain free key at: https://www.abuseipdb.com/pricing
ABUSEIPDB_API_KEY=

# Obtain free key at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
